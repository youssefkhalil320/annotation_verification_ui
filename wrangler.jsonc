{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "annotation-verification-ui",
  "main": "./src/worker.js",
  "compatibility_date": "2025-11-09",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "REVIEW_DB",
      "database_name": "annotation-reviews",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
